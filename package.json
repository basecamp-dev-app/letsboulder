{
  "name": "letsboulder",
  "version": "0.1.0",
  "engines": {
    "node": "22.23.2"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "fast-uri": "^4.1.4",
    "flatted": "^3.4.2",
    "js-yaml": "^4.3.1",
    "nanoid": "^6.0.1",
    "undici": "^7.29.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --turbopack",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --turbopack && node scripts/generate-sw-build-assets-manifest.js",
    "media-backfill": "node scripts/media/backfill-images.mjs",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint --cache --concurrency auto",
    "check:csrf-fetch": "node scripts/check-api-mutation-fetches.mjs",
    "check:type-drift": "node scripts/check-generated-types.mjs",
    "lint:features": "eslint --concurrency off features/ --rule 'local-rules/consistent-feature-structure: warn'",
    "check:features": "tsx scripts/check-feature-compliance.ts",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "export:public-data": "tsx scripts/public-data/export.ts",
    "typecheck": "npm run typecheck:app && npm run typecheck:tests && npm run typecheck:scripts && npm run typecheck:media-worker",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:media-worker": "npm --prefix apps/media-worker run check",
    "test:unit": "vitest run --config vitest.config.ts",
    "test": "npm run test:unit",
    "test:components": "vitest run --config vitest.component.config.ts",
    "test:database": "vitest run --config vitest.database.config.ts",
    "test:e2e": "playwright test",
    "test:workflow-regressions": "vitest run --config vitest.config.ts tests/workflows/*.test.ts",
    "test:e2e:production-audit": "RUNTIME_AUDIT_RUN=true playwright test -c playwright.runtime-audit.config.ts --project=mobile-chrome --project=mobile-safari tests/mobile-runtime-audit.spec.ts",
    "test:e2e:release-audit": "RUNTIME_AUDIT_RUN=true RUNTIME_AUDIT_PROFILE=release playwright test -c playwright.runtime-audit.config.ts --retries=2 --project=mobile-chrome --project=mobile-safari tests/mobile-runtime-audit.spec.ts tests/mobile-runtime-audit.release.spec.ts",
    "audit:runtime-artifacts": "node scripts/playwright/runtime-audit-artifacts.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.87.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^1.6.1",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "exifr": "^7.1.3",
    "heic2any": "^0.0.4",
    "idb": "^8.0.3",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.0",
    "piexifjs": "^1.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/piexifjs": "^1.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.11.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "p-limit": "^7.3.1",
    "pg": "^8.22.0",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "tsx": "4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vitest": "^4.0.18"
  }
}
