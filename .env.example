# Copy to .env.local. Use `npx supabase status` for local Supabase values.

# Core local application
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=local_service_role_key
CSRF_SECRET=<generate-with-openssl-rand-hex-32>
DELETE_ACCOUNT_SECRET=<generate-with-openssl-rand-hex-32>
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://letsboulder.com
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Route-photo media storage and delivery
R2_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PRIVATE_BUCKET=lb-dev-media-private
R2_PUBLIC_BUCKET=lb-dev-media-public
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret-key>
NEXT_PUBLIC_MEDIA_CDN_URL=https://static.dev.letsboulder.com

# Optional Next.js -> Worker queue fast path. Worker INGRESS_SECRET must match.
# CF_MEDIA_WORKER_URL=https://<worker-host>
# CF_MEDIA_WORKER_SECRET=<shared-ingress-secret>

# Optional media diagnostics and rollout controls
# NEXT_PUBLIC_ALLOW_PENDING_IMAGES=false
# NEXT_PUBLIC_DEBUG_IMAGE_UPLOADS=0
# DEBUG_SUBMISSIONS_AUTH=1

# Optional transactional services
# RESEND_API_KEY=re_...
# DISCORD_SUBMISSIONS_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_FLAGS_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_GYM_OWNERS_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional distributed rate limiting. Without these, critical tiers use a
# per-process in-memory fallback and other tiers fail open.
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# Optional error monitoring
# SENTRY_DSN=https://...
# Keep replay disabled unless privacy/legal review explicitly approves it.
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0

# Playwright and non-production test auth. Prefer tests/.env.test.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# PLAYWRIGHT_SKIP_GLOBAL_SETUP=false
# IMAGE_FIRST_E2E_URL=/gb/maintained-crag/i/maintained-image-id
# PW_GREP=<playwright-grep-regex>
# PW_GREP_INVERT=<playwright-grep-invert-regex>
# ENABLE_TEST_AUTH_ENDPOINT=true
# TEST_API_KEY=<test-api-key>
# TEST_USER_EMAIL=<local-test-user-email>
# TEST_USER_ID=<local-test-user-id>
# TEST_USER_PASSWORD=<local-test-user-password>
# TEST_AUTH_PATH_SEGMENT=<unguessable-path-segment>
# DEV_SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>
# INTERNAL_TEST_KEY=<internal-test-key>
# CF_ACCESS_CLIENT_ID=<cloudflare-access-client-id>
# CF_ACCESS_CLIENT_SECRET=<cloudflare-access-client-secret>

# Database tests default to the local Supabase PostgreSQL URL.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# TEST_DATABASE_ALLOW_NON_LOCAL=false

# Set by deployment platforms; normally do not define locally.
# VERCEL_ENV=preview
# VERCEL_URL=<deployment-host>
