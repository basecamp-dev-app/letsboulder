# Copy this to .env.local and fill in values for local development
# Run `supabase start` to get local credentials

# Supabase local development
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=local_service_role_key

# Dev auth (optional)
NEXT_PUBLIC_DEV_PASSWORD_AUTH=true
DEV_USER_EMAIL=hello@letsboulder.com
DEV_USER_PASSWORD=devpassword123

# Cloudflare R2 media storage
R2_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PRIVATE_BUCKET=lb-dev-media-private
R2_PUBLIC_BUCKET=lb-dev-media-public
R2_ACCESS_KEY_ID=<your-r2-access-key>
R2_SECRET_ACCESS_KEY=<your-r2-secret-key>

# Media CDN (Cloudflare Worker)
# Local: run `cd apps/media-worker && npx wrangler dev --env staging` then use localhost
NEXT_PUBLIC_MEDIA_CDN_URL=http://localhost:8787
# Staging:
# NEXT_PUBLIC_MEDIA_CDN_URL=https://static.dev.letsboulder.com
# Production:
# NEXT_PUBLIC_MEDIA_CDN_URL=https://static.letsboulder.com

# CSRF protection (required)
CSRF_SECRET=<generate-a-secure-random-string>

# ============================================
# PRODUCTION SECRETS (Configure in Vercel Dashboard)
# Do NOT commit production secrets to this file
# ============================================

# Required for production:
# - NEXT_PUBLIC_SUPABASE_URL (your production Supabase URL)
# - NEXT_PUBLIC_SUPABASE_ANON_KEY (production anon key)
# - SUPABASE_SERVICE_ROLE_KEY (production service role key - server-side only!)
# - R2_S3_ENDPOINT, R2_PRIVATE_BUCKET, R2_PUBLIC_BUCKET
# - R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
# - NEXT_PUBLIC_MEDIA_CDN_URL (production CDN URL)
# - CSRF_SECRET (JWT signing secret for CSRF tokens)

# Optional (remove if not used):
# - NEXT_PUBLIC_DEV_PASSWORD_AUTH (set to false in production)
# - DEV_USER_EMAIL (dev only)
# - DEV_USER_PASSWORD (dev only)

# Account deletion token secret (required in production)
DELETE_ACCOUNT_SECRET=<generate-a-secure-random-string>

# Resend for transactional emails (welcome emails, delete confirmations)
# Get your API key from: https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Discord webhooks (optional)
# DISCORD_SUBMISSIONS_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_FLAGS_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_GYM_OWNERS_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Upstash Redis for rate limiting (optional)
# If omitted, rate limiting falls back to an in-memory store:
#   - Non-critical endpoints: fail open (limit: 9999, always allowed)
#   - Critical endpoints (sensitive, strict, submissions): enforce limits in-memory per-process
# In-memory fallback is not shared across instances, so deploy with Upstash for production.
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# Cloudflare Worker auth (for Next.js <-> Worker communication)
# CF_MEDIA_WORKER_INGRESS_SECRET=<shared-secret>

# Sentry error tracking (optional - recommended for production)
# SENTRY_DSN=https://xxxxxxx@xxxxxxx.ingest.sentry.io/xxxxxxx
# SENTRY_TRACES_SAMPLE_RATE=0.05
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# NEXT_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
